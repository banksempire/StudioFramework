{
  "name": "studioframework",
  "version": "1.0.0",
  "description": "VSCode-like UI framework in TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 7492",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/check-ui.cjs",
    "check:dtt": "node scripts/check-dtt.cjs",
    "check:utils": "node scripts/check-utils.cjs",
    "check:autohide": "node scripts/check-autohide.cjs",
    "check:mobile": "node scripts/check-mobile.cjs",
    "check:singlemenu": "node scripts/check-single-menu.cjs",
    "check:tree": "node scripts/check-tree.ts",
    "check:snap": "node scripts/check-snapshots.ts",
    "check:tabfit": "node scripts/check-tabfit.cjs",
    "check:ws": "node scripts/check-workspace-app.cjs",
    "check:persist": "node scripts/check-persist.cjs",
    "check:corners": "node scripts/check-corners.cjs",
    "check:selectors": "node scripts/check-selectors.cjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "vue": "^3.5.40"
  }
}
